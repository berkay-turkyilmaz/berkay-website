# Required for AI Lab chat, PDF sandbox, and streaming endpoints (server-only)
GROQ_API_KEY=

# Public site URL (used for canonical, sitemap, OG). Defaults to https://berkay-dev.vercel.app
NEXT_PUBLIC_SITE_URL=

# Server-only n8n webhooks used by /api/contact and /api/booking (never exposed to the browser)
CONTACT_WEBHOOK_URL=
BOOKING_WEBHOOK_URL=

# docker-compose (local n8n)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=
